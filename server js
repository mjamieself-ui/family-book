const express = require('express');
const session = require('express-session');
const db = require('./database');
const app = express();

app.set('view engine', 'ejs');
app.use(express.urlencoded({ extended: true }));
app.use(express.static('public'));

app.use(session({
  secret: 'family-nostalgia-secret-key',
  resave: false,
  saveUninitialized: true
}));

const requireFamilyAuth = (req, res, next) => {
  if (req.session.authenticated) {
    next();
  } else {
    res.redirect('/login');
  }
};

app.get('/login', (req, res) => {
  res.render('login', { error: null });
});

app.post('/login', (req, res) => {
  const { password } = req.body;
  const familyPassword = process.env.FAMILY_PASSWORD || 'ourfamily123';
  
  if (password === familyPassword) {
    req.session.authenticated = true;
    res.redirect('/');
  } else {
    res.render('login', { error: 'Incorrect family password!' });
  }
});

app.get('/', requireFamilyAuth, (req, res) => {
  db.all(`SELECT posts.*, users.name as author_name, users.avatar_url FROM posts 
          JOIN users ON posts.author_id = users.id 
          WHERE target_user_id IS NULL 
          ORDER BY created_at DESC`, [], (err, posts) => {
    db.all(`SELECT * FROM events ORDER BY event_date ASC`, [], (err, events) => {
      db.all(`SELECT * FROM users`, [], (err, users) => {
        res.render('index', { posts, events, users });
      });
    });
  });
});

console.log("System ready. Hooks initialized for background workers.");

const PORT = process.env.PORT || 3000;
app.listen(PORT, () => console.log(`FamilyBook running on port ${PORT}`));

